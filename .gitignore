# ============================================================
# SocialMind — Git Ignore Rules
# ============================================================

# -- Python ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# -- Virtual Environments --------------------------------
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# -- Environment Variables / Secrets --------------------
# IMPORTANT: Never commit real API keys or credentials
.env
.env.*
*.env
secrets.py
config.local.py
credentials.py
.secrets/

# -- Flask / App specific --------------------------------
instance/
*.db
*.sqlite3
flask_session/

# -- Distribution / Build --------------------------------
dist/
build/
*.egg-info/
.eggs/
wheels/
*.whl

# -- Testing ---------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# -- Jupyter Notebooks -----------------------------------
.ipynb_checkpoints
*.ipynb

# -- IDEs and Editors ------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# -- macOS -----------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# -- Windows ---------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -- Logs ------------------------------------------------
*.log
logs/
*.log.*

# -- Uploads (user image inputs, processed client-side) --
uploads/
static/uploads/
temp_uploads/

# -- IBM Watson / watsonx config -------------------------
ibm-credentials.env
wml_credentials.json

# -- Misc ------------------------------------------------
*.bak
*.tmp
*.temp
.cache/
